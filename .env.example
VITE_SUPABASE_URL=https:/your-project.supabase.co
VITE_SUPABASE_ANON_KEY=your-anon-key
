@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #f3f7fb;
  --panel: #ffffff;
  --panel-soft: #eef5ff;
  --primary: #1c7c54;
  --primary-dark: #135a3d;
  --primary-soft: rgba(28, 124, 84, 0.1);
  --accent: #f3b84e;
  --text: #132238;
  --muted: #64748b;
  --border: #dfe7f1;
  --success: #0f9d72;
  --warning: #d97706;
  --danger: #dc2626;
  --shadow: 0 10px 30px rgba(16, 38, 57, 0.08);
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  height: 100%;
  font-family: 'Inter', sans-serif;
  background: linear-gradient(135deg, #edf5ef 0%, #f7f8ff 100%);
  color: var(--text);
}

body {
  min-height: 100vh;
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
  border: none;
}

.app-shell {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  width: 260px;
  background: linear-gradient(180deg, #123f2d 0%, #0d2f22 100%);
  color: #f8fafc;
  padding: 24px 18px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.brand-box {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 8px 18px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.brand-mark {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #d4f7e5, #6dd3a0);
  border-radius: 12px;
  color: var(--text);
  font-weight: 800;
}

.brand-box strong,
.brand-box small {
  display: block;
}

.brand-box small {
  color: rgba(255, 255, 255, 0.75);
}

.nav {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.nav-item {
  text-decoration: none;
  color: rgba(255,255,255,0.83);
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 11px 12px;
  border-radius: 12px;
  transition: 0.2s ease;
}

.nav-item:hover,
.nav-item.active {
  background: rgba(255,255,255,0.08);
  color: #fff;
}

.sidebar-card {
  margin-top: auto;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 16px;
  padding: 14px;
  display: flex;
  gap: 12px;
  align-items: center;
}

.card-icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  background: rgba(255, 255, 255, 0.1);
}

.sidebar-card p {
  margin: 4px 0 0;
  color: rgba(255,255,255,0.8);
  font-size: 0.8rem;
}

.main-panel {
  flex: 1;
  padding: 30px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 28px;
}

.eyebrow {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.72rem;
  color: var(--muted);
  font-weight: 700;
}

.topbar h2,
.page-top h1,
.panel-header h3,
.event-card h3 {
  margin: 6px 0 0;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.ghost-button,
.primary-button,
.pill-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 16px;
  border-radius: 12px;
  font-weight: 600;
}

.ghost-button {
  background: rgba(17, 24, 39, 0.04);
  color: var(--text);
}

.ghost-button.signed-out {
  background: rgba(28, 124, 84, 0.08);
  color: var(--primary-dark);
}

.primary-button {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: white;
  box-shadow: var(--shadow);
}

.pill-button {
  background: var(--panel-soft);
  color: var(--primary-dark);
  border: 1px solid var(--border);
  padding: 8px 12px;
  font-size: 0.86rem;
}

.page-stack {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.page-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.stats-grid.mini {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.stat-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 18px 18px 16px;
  box-shadow: var(--shadow);
}

.stat-card.primary {
  background: linear-gradient(135deg, #ffffff, #ebfff5);
}

.stat-card.success {
  background: linear-gradient(135deg, #ffffff, #edfef7);
}

.stat-card.warning {
  background: linear-gradient(135deg, #ffffff, #fff6e9);
}

.stat-card.neutral {
  background: linear-gradient(135deg, #ffffff, #f5f7ff);
}

.stat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--muted);
  font-size: 0.85rem;
}

.stat-card h3 {
  margin: 18px 0 8px;
  font-size: clamp(1.6rem, 3vw, 2.2rem);
}

.stat-card p {
  margin: 0;
  color: var(--muted);
  font-size: 0.84rem;
}

.trend {
  color: var(--success);
  font-weight: 700;
}

.two-col-grid {
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  gap: 18px;
}

.panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 18px;
  box-shadow: var(--shadow);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.table-wrap {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
}

th, td {
  padding: 12px 10px;
  border-bottom: 1px solid var(--border);
  text-align: left;
}

th {
  color: var(--muted);
  font-size: 0.82rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 0.76rem;
  font-weight: 700;
}

.badge.present {
  background: rgba(15, 157, 114, 0.12);
  color: var(--success);
}

.badge.late {
  background: rgba(217, 119, 6, 0.12);
  color: var(--warning);
}

.event-list, .settings-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.event-item {
  display: flex;
  align-items: center;
  gap: 14px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 12px;
}

.event-date {
  min-width: 64px;
  text-align: center;
  background: var(--panel-soft);
  border-radius: 12px;
  padding: 8px 6px;
  color: var(--primary-dark);
}

.event-date span {
  display: block;
  font-size: 0.7rem;
  text-transform: uppercase;
}

.event-date strong {
  font-size: 1.2rem;
}

.event-item h4 {
  margin: 0 0 4px;
  font-size: 1rem;
}

.event-item p {
  margin: 0;
  color: var(--muted);
  font-size: 0.8rem;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 8px 10px;
}

.search-box input {
  border: none;
  background: transparent;
  outline: none;
  width: 170px;
}

.event-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.event-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 18px;
  box-shadow: var(--shadow);
  overflow: hidden;
}

.event-card-date {
  padding: 18px;
  background: linear-gradient(135deg, var(--primary-soft), #eefcf5);
  border-bottom: 1px solid var(--border);
  text-align: center;
}

.event-card-date span {
  display: block;
  text-transform: uppercase;
  font-size: 0.72rem;
  color: var(--primary-dark);
}

.event-card-date strong {
  display: block;
  margin-top: 6px;
  font-size: 2rem;
  color: var(--primary-dark);
}

.event-card-body {
  padding: 18px;
}

.event-card-body h3 {
  margin: 0 0 10px;
}

.event-card-body p {
  margin: 0 0 8px;
  color: var(--muted);
}

.settings-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.settings-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.settings-list li {
  padding: 10px 0;
  border-bottom: 1px solid var(--border);
  color: var(--text);
}

.positive {
  color: var(--success);
  font-weight: 700;
}

.negative {
  color: var(--danger);
  font-weight: 700;
}

@media (max-width: 980px) {
  .app-shell {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
  }

  .main-panel {
    padding: 20px;
  }

  .stats-grid,
  .stats-grid.mini,
  .two-col-grid,
  .settings-grid,
  .event-grid {
    grid-template-columns: 1fr;
  }

  .page-top,
  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }
}
